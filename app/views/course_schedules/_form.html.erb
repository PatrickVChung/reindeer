
<%= simple_form_for(@course_schedule) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
  <div class="card mx-auto" style="width: 75%;">
    <div class="card-header"><h5><%= @course_schedule_header %>: [ <%= params[:course_number] %> ] <%= params[:course_name] %></h5></div>
    <div class="card-body">
      <div class="form-inputs">

        <div class="row mb-0">
          <%= f.label "Course Id", class: "col-sm-2 control-label right-label" %>
          <div class="col-sm-6">
             <%= f.input_field :course_id, required: true, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-0">
          <%= f.label "year", class: "col-sm-2 control-label right-label" %>
          <div class="col-sm-6">
             <%= f.input_field :year, required: true, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-0">
          <%= f.label "Block", class: "col-sm-2 control-label right-label" %>
          <div class="col-sm-6">
             <%= f.input_field :block, required: true, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3"> <%# Changed mb-0 to mb-3 for cleaner Bootstrap spacing %>
          <label class="control-label col-md-2 right-label" for="course_schedule_start_date">
            Start Date <i class="fa fa-calendar"></i>
          </label>
          <div class="col-sm-6">
            <%= f.date_field :start_date,
                             required: true,
                             class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3">
          <label class="control-label col-md-2 right-label" for="course_schedule_end_date">
            End Date <i class="fa fa-calendar"></i>
          </label>
          <div class="col-sm-6">
            <%= f.date_field :end_date,
                             required: true,
                             class: "form-control" %>
          </div>
        </div>
        <div class="row mb-0">
          <%= f.label "No of Seats", class: "col-sm-2 control-label right-label" %>
          <div class="col-sm-6">
             <%= f.input_field :no_of_seats, class: "form-control" %>
          </div>
        </div>
        <div class="row mb-0">
          <%= f.label "Comment", class: "col-sm-2 control-label right-label" %>
          <div class="col-sm-8">
             <%= f.input_field :comment, required: true, class: "form-control" %>
          </div>
        </div>

      </div>

      <div class="form-actions">
        <%= f.button :submit, class: "btn btn-primary" %>
      </div>
    </div>
  </div>

<% end %>
