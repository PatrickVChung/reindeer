<br />
<div class="row">
  <div class="card w-75">
    <h3 style="font-family:cambria; text-align: right;">YourMD Course Catalog</h3>
    <hr style="height:3px; background-color:grey;">

    <% course_detail = @course_detail.first  %>
    <h4 style="color:#0092ca;font-family:cambria"><strong><%= course_detail["course_number"].to_s %> <%= course_detail["course_name"] %></strong></h4>
    <h5><i style="color:#455d7a;font-family:cambria"><%= course_detail["department"] %> </i></h5>
    <div class="calibri-font">
      <strong>Course Purpose Statement:</strong>&ensp;<%= course_detail["course_purpose_statement"] %><br><br>
      <strong>Special Notes:</strong>&ensp;<%= course_detail["special_notes"] %><br><br>
      <strong>Required Prerequisite(s):</strong>&ensp;<%= course_detail["required_prerequisites"] %><br>
      <i>Course Director may waive prerequisites on a case-by-case basis for this course..</i>
      <hr style="height:3px; background-color:#3e4a61;">
      <div class="row">
        <div class="col-md-6">
          <strong>Duration:</strong>&ensp;<%= course_detail["duration"] %><br>
          <strong>Site(s):</strong>&ensp;<%= course_detail["site"] %><br>
          <strong>Type:</strong>&ensp;<%= course_detail["content_type"] %> <br>
          <strong>Credits:</strong>&ensp;<%= course_detail["credits"] %><br>
          <strong>Available through the lottery: </strong>&ensp;<%= course_detail["available_through_the_lottery"] %>
        </div>
        <div class="col-md-6">
          <strong>Course Director (name / email):</strong>&ensp;<%= course_detail["course_director"] %> / <%= course_detail["course_director_email"] %><br>
          <strong>Course Coordinator (name / email):</strong>&ensp;<%= course_detail["course_coordinator"] %> / <%= course_detail["course_coordinator_email"] %> <br>
        </div>
      </div>
      <hr style="height:3px; background-color:#3e4a61;">
    </div>
    <div class="row">
      <div class="col-9">
        <h6 style="text-align: center;"><strong> Available Blocks: </strong></h6>
        <table class="table-responsive nowrap table table-hover table-bordered table3-striped custom-grid-color">
          <thead>
            <tr>
            <th style="text-align: center;">Year</th>
            <th style="text-align: center; width: 15%;">Block</th>
            <th style="text-align: center; width: 15%;">StartDate</th>
            <th style="text-align: center; width: 15%;">EndDate</th>
            <th style="text-align: center;">Capacity</th>
            </tr>
          </thead>
          <% @course_schedules.each do |course_schedule| %>
            <tr>
              <td style="text-align: center;"><%= course_schedule.year %></td>
              <td style="text-align: center;"><%= course_schedule.block %></td>
              <td style="text-align: center;"><%= course_schedule.start_date %></td>
              <td style="text-align: center;"><%= course_schedule.end_date %></td>
              <% if (course_schedule.no_of_seats.nil? || course_schedule.comment.nil?) %>
                <td style="text-align: center;"><%= course_schedule.no_of_seats %><%= course_schedule.comment%></td>
              <% else %>
                <td style="text-align: center;"><%= course_schedule.no_of_seats %> / <%= course_schedule.comment%></td>
              <% end %>
            </tr>
          <% end %>

        </table>

      </div>
      <div class="col-sm-2">
        <div class="grid-container">
          <strong>Competencies Assessed: </strong>
          <ul>
            <% course_detail["competencies"].each do |comp| %>
              <li><%= comp %></li>
            <% end %>
          </ul>
        </div>
      </div>
      <hr style="height:4px; background-color:#B2DBED;">
      <h6 style="color: #0092ca;"><strong> <%= course_detail["category"] %> </strong></h6>
    </div>
  </div>
