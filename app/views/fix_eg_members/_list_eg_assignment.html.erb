<% if !@eg_cohorts.nil? %>
    <br />
    <h5>EG Assignment -Click here to Download
    <%= link_to ('<i class="fa fa-download"></i>').html_safe, download_file_fix_eg_members_path(file_name: @eg_assignment_filename) %></h5>
    <table class="responsive nowrap table table-hover">
      <th>Action</th>
      <% @eg_cohorts.first.keys.each do |header| %>
        <th><%= header %></th>
      <% end %>

      <% @eg_cohorts.each do |data| %>
        <tr>
          <td>
            <%= button_to delete_cohort_fix_eg_members_path(eg_cohort_email: data["email"]),
                          method: :delete,
                          form: { data: { turbo_confirm: 'Are you sure?' } },
                          class: 'delete_review fa fa-trash' do %>
              -Delete
            <% end %>
          </td>
          <% data.each do |key, val| %>
            <td> <%= val %> </td>
          <% end %>
        </tr>
      <% end %>

    </table>

<% end %>
