  <div class="card">
    <div class="card-body">
      <%= form_with(url: update_plans_ume_assess_plans_path, method: :get) do |form| %>
        <div class="input-group">
          <h4>UME Assessessment Plans (FileDownload<%= link_to ('<i class="fa fa-download"></i>').html_safe, download_file_ume_assess_plans_path(file_name: 'ume_assess_plans.txt') %>)</h4>
          &nbsp; &nbsp;
          <span class="input-group-text bg-warning" id="inputGroup-sizing-lg">Year</span>
          <input type="text" class="form-control" name="year" placeholder="eg. 2024-2025" required>
          <span class="input-group-text bg-warning" id="inputGroup-sizing-lg">Cohort</span>
          <input type="text" class="form-control" style="width: 20em;" name="Cohort" placeholder="eg. Med28 (case sensitive)">
          <span class="input-group-text bg-warning" id="inputGroup-sizing-lg">Start Date</span>
          <input type="text" class="form-control" name="start_date" placeholder="Fmt: YYYY-DD-YY" required>
          <span class="input-group-text bg-warning id="inputGroup-sizing-lg">End Date</span>
          <input type="text" class="form-control" name="end_date"  placeholder="Fmt: YYYY-DD-YY" required>
          <button class="btn btn-primary" type="submit">Submit form</button>
        </div>
      <% end %>
    </div>
  </div>

<div class="card">
  <div class="card-body">
    <%= link_to 'New Ume Assess Plan', new_ume_assess_plan_path, target: "_blank", class: "btn btn-primary btn-sm" %>    
    <table class="responsive nowrap table table-hover table-striped" id="dttb-ume_assess_plans" data-sort="true" data-source="<%= url_for(format: :json)%>">
      <thead>
        <tr>
          <th data-data="id">Id</th>
          <th data-data="year" style="width: 5%">Year</th>
          <th data-data="competency">Competency</th>
          <th data-data="student_learning_objective">Student learning objective</th>
          <th data-data="assessment_description">Assessment Desc</th>
          <th data-data="method">Method</th>
          <th data-data="target">Target</th>
          <th data-data="resource">Resource</th>
          <th data-data="target_met" style="width: 5%">Target Met</th>
          <th data-data="target_results" style="width: 15%">Target Results</th>
          <th data-data="rubric_use" style="width: 5%">Rubric Use</th>
          <th data-data="action" style="width: 5%">Action</th>
          <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
        </tr>
      </thead>
      <% @ume_assess_plans.each do |plan| %>
        <tr>
          <td><%= plan.id %></td>
          <td><%= plan.year %></td>
          <td><%= plan.competency %></td>
          <td><%= plan.student_learning_objective %></td>
          <td><%= plan.assessment_description %></td>
          <td><%= plan.method %></td>
          <td><%= plan.target %></td>
          <td><%= plan.resource %></td>
          <td class="text-center" style="background-color:lightblue"><%= plan.target_met ? 'Yes' : 'No' %></td>
          <td style="background-color:#F2AACB"><%= plan.target_results %></td>
          <td class="text-center"><%= plan.rubric_used ? 'Yes' : 'No'%></td>
          <td>
            <%= link_to 'Edit', edit_ume_assess_plan_path(plan) %> /
            <%= link_to 'Destroy', plan, method: :delete, data: { confirm: 'Are you sure?' } %></td>
          </td>
        </tr>
      <% end %>
    </table>
  </div>
</div>

<br>
