<h5>CreatePdfs#create_and_move_pdf</h5>
Found File Name: <b><%= @filename.to_s %></b><i> (if the File Name is BLANK, please upload the file first!)</i><br><br>
<% if !@filename.nil? %>
  <%= form_with(url: move_pdf_create_pdfs_path, method: :get) do |form| %>

    <%= form.hidden_field :found_file, value: @filename %>
    <%= form.hidden_field :artifact_id, value: @artifact.id %>

    <div class="input-group input-group-sm mb-3">
      <span class="input-group-text bg-info" id="inputGroup-sizing-sm">Cohort</span>
      <input type="text" class="form-control" Name="Cohort" placeholder="eg. Med28 (case sensitive)">
      <span class="input-group-text bg-info" id="inputGroup-sizing-sm">Block Code</span>
      <input type="text" class="form-control" Name="BlockCode" placeholder="ValidCode: FUND,BLHD,SBM,CPR,HODI,NSF,DEVH">
      <span class="input-group-text bg-info" id="inputGroup-sizing-sm">File Type</span>
      <input type="text" class="form-control" name="FileType" value="_Informatics_CSA_Qualtrics">

    </div>
    <div class="mb-3">
      <label for="Header1" class="form-label">Header 1</label>
      <textarea class="form-control" id="Header1" name='header1' rows="2" ><%= hf_header1 %></textarea>
    </div>
    <div class="mb-3">
      <label for="Header2" class="form-label">Header 2</label>
      <textarea class="form-control" id="Header2" name='header2' rows="4"><%= hf_header2 %></textarea>
    </div>
    <div class="mb-3">
      <label for="Header3" class="form-label">Header 3</label>
      <textarea class="form-control" id="Header3" name='header3' rows="4"><%= hf_header3 %></textarea>
    </div>

    <button class="btn btn-primary" type="submit">Submit form</button>
  <% end %>

<% end %>
