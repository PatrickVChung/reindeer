
  <div class="justify-content-center">
    <%= form_with(url: final_evals_medhub_apis_path, method: :get) do |form| %>
      <table id="courseDataTable" class="table table-hover table-striped table-responsive" data-sort="true" >
        <thead>
          <tr class="filters">
            <th style="width: 20%">Check Courses To Retreive FinalEvals from Medhub </th>
            <th style="text-align:center">CourseID</th>
            <th style="text-align:center">CourseCore</th>
            <th style="text-align:left">Coourse Name</th>

          </tr>
        </thead>
          <% courses.each do |course| %>
            <tr>
              <td>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="checkboxId_<%= course.course_id %>" value="<%= course.course_id %>" name="course_ids[]" >
                  <label class="form-check-label" for="checkboxId_<%= course.course_id %>">
                    <%= course.course_code %>
                  </label>
                </div>
              </td>
              <td style="text-align:center"> <%= course.course_id %> </td>
              <td style="text-align:center"> <%= course.course_code %> </td>
              <td style="text-align:left"> <%= course.course_name%> </td>
            </tr>
          <% end %>

          <tr>
            <td>
              <span>
                  <div class="form-input inline">
                    <label for="startYr" class="form-label">Rotation Start Year (YY)</label>
                    <input type="text" class="form-control w-25" name="rotationStartYr" value=25>
                    <label for="endYr" class="form-label">Rotation End Year (YY)</label>
                    <input type="text" class="form-control w-25" name="rotationEndYr"value=26>
                    <label for="studentLevel" class="form-label">Student Level </label>
                    <input type="text" class="form-control w-25" name="studentLevel" value=4 placeholder="Enter 3 or 4">
                    <label for="evalStartDate" class="form-label">Eval Start Date (YYYY/MM/DD) </label>
                    <% eval_start_date = hf_eval_start_date %>
                    <input type="text" class="form-control w-25" name="evalStartDate" value="<%= eval_start_date %>" placeholder="Default to Beginning of Year">
                  </div>
              <span>
            </td>
            <td></td>
            <td></td>
            <td></td>
          </tr>

          <tr>
              <td>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="EnabledDebug" id="EnabledDebug">
                  <label class="form-check-label" for="EnabledDebug">
                    Enable Debug
                  </label>
                  <%= form.button type: "submit", class: "btn btn-info", data: { "disable-with": "<i class='fa fa-spinner fa-spin'></i> Accessing..." } do %>
                    <i class="fa fa-file"></i> Accessing Mehdub APIs..
                  <% end %>
                </div>
              </td>
              <td></td>
              <td></td>
              <td></td>
          </tr>
      </table>
    <% end %>
  </div>
