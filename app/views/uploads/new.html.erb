<%# app/views/uploads/new.html.erb %>

<h3>Existing Files</h3>
<% if @files.any? %>
  <table class="responsive nowrap table table-hover table-striped" border="1" cellpadding="10" style="border-collapse: collapse;">
    <thead>
      <tr>
        <th>Filename</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @files.each do |file| %>
        <tr>
          <td><%= link_to file, "/uploads/#{file}", target: "_blank" %></td>
          <td>
            <%= link_to "Delete", delete_upload_path(filename: file),
                        data: { method: :delete, confirm: "Are you sure?" },
                        style: "color: red;" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No files uploaded yet.</p>
<% end %>


<h5>Upload a File</h5>

<%= form_with url: uploads_path, local: true, multipart: true do |f| %>
  <div style="margin-bottom: 10px;">
    <%= f.label :my_file, "Select File" %>
    <%= f.file_field :my_file %>
  </div>

  <%= f.submit "Upload Now", class: "btn btn-primary" %>
<% end %>

<% if flash[:notice] %>
  <p style="color: green;"><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p style="color: red;"><%= flash[:alert] %></p>
<% end %>
