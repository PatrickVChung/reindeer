<br >

<h5> Bulk Delete Files from Artifacts </h5>
<%= form_with(url: bulk_remove_artifacts_path, method: :get) do |form| %>

  <div class="input-group input-group-sm mb-3">
    <span class="input-group-text bg-info" id="inputGroup-sizing-sm">Cohort</span>
    <input type="text" class="form-control" Name="Cohort" placeholder="eg. Med28 (case sensitive)">
    <span class="input-group-text bg-info" id="inputGroup-sizing-sm">Block Code</span>
    <input type="text" class="form-control" Name="BlockCode" placeholder="ValidCode: FUND,BLHD,SBM,CPR,HODI,NSF,DEVH">
    <span class="input-group-text bg-info" id="inputGroup-sizing-sm">File Type</span>
    <input type="text" class="form-control" name="FileType" placeholder="ValidCode: NBME, Informatics">
    <button class="btn btn-primary" type="submit">Submit form</button>
  </div>
<% end %>

<hr>
<% if !@bulk_remove_files.empty? %>
  <%= form_with(url: purge_all_documents_artifacts_path, method: :get) do |form| %>
    <%= form.hidden_field :title, value: params[:title] %>
    <%= form.hidden_field :content, value: params[:content]%>
    <%= form.hidden_field :file_type, value: params[:FileType] %>
    <div class='card'>
      <div class="card-body">
        <span class="input-group-text">
          <h5> The following files will be DELETED from the student's Artifact Table.
          <button class="btn btn-primary" type="submit">Delete All</button> Total # of Files: <%= @bulk_remove_files.count %></h5>
        </span>

       <table class="responsive nowrap table table-hover table-striped" id="prob_artifact" >
         <thead>
           <tr>
             <th>UserID</th>
             <th>ArtifactID</th>
             <th>Title</th>
             <th>Content</th>
             <th>BlobId</th>
             <th>FileType</th>
             <th>FileName</th>
           </tr>
         </thead>

           <% @bulk_remove_files.each do |file| %>
             <tr>
               <td><%= file["user_id"] %></td>
               <td><%=file["artifact_id"] %></td>
               <td><%=file["title"] %></td>
               <td><%=file["content"] %></td>
               <td><%=file["blob_id"] %></td>
               <td><%=file["file_type"] %></td>
               <td><%=file["filename"] %></td>
             </tr>
           <% end %>
       </table>
     </div>
    </div>
  <% end %>
<% else %>
  <br >
  <h5>==== No Files Found! ======</h5>
<% end %>
