<!-- app/views/courses/index.html.erb -->
<div class="container-fluid">
  <div class="row">
    <div class="col-md-2">
      <div class="card">
        <div class="card-header bg-danger text-white">
          Search
        </div>
        <div class="card-body">
          <%= form_with url: courses_path, method: :get, local: true do |form| %>
              <div class="card-header">
                <strong>Keyword Search </strong><button id="clearAllCheckboxesBtn" class="btn btn-sm btn-primary">Clear All Checkboxes</button>
              </div>
              <div class="card-body">
               <input type="text" class="form-control" id="searchWord" name="searchWord" placeholder="Enter keywords here" value="<%= params[:searchWord] %>">
              </div>
              <div class="accordion" id="accordionFilters">
                <%= render partial: "filter_table",
                           locals: {
                             title: "Course Type",
                             items: @categories,
                             selected_param: params[:categories],
                             field_name: "categories",
                             count_hash: @category_count,
                             prefix: "cat"
                           } %>

                <%= render partial: "filter_table",
                           locals: {
                             title: "Department",
                             items: @departments,
                             selected_param: params[:departments],
                             field_name: "departments",
                             count_hash: @department_count,
                             prefix: "dep"
                           } %>

               <%= render partial: "filter_table",
                          locals: {
                            title: "Course Information",
                            items: @course_info,
                            selected_param: params[:course_info],
                            field_name: "course_info",
                            count_hash: @course_info_count,
                            prefix: "info"
                          } %>

              <%= render partial: "filter_table",
                         locals: {
                           title: "Course Prerequisite",
                           items: [['Yes', true], ['No', false]],
                           selected_param: params[:prerequisites],
                           field_name: "prerequisites",
                           count_hash: {},
                           prefix: "prereq"
                         } %>



                <%= render partial: "filter_table",
                           locals: {
                             title: "Duration",
                             items: @durations,
                             selected_param: params[:durations],
                             field_name: "durations",
                             count_hash: @duration_count,
                             prefix: "dur"
                           } %>

                 <%= render partial: "filter_table",
                            locals: {
                              title: "Block Offered",
                              items: @offerings,
                              selected_param: params[:offerings],
                              field_name: "offerings",
                              count_hash: @offering_count,
                              prefix: "off"
                            } %>

                  <%= render partial: "filter_table",
                             locals: {
                               title: "Competency",
                               items: CourseSchedule.comp_codes,
                               selected_param: params[:competencies],
                               field_name: "competencies",
                               count_hash: @competencies_count,
                               prefix: "comp"
                             } %>

                </div>
              <br>
              <%= form.submit "Search", id: "sbumit-btn", class: "btn btn-primary" %>
            <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-9">
      <div class="card">
        <div class="card-header bg-danger text-white">
          <%= "Found #{@courses.count.to_s} courses." %>
        </div>
        <div class="card-body">
          <% if !@courses.nil? %>
            <%= render @courses %>
          <% end %>
        </div.
      </div>
    </div>
  </div>
</div>
