<br><br>
<div class="card" >
  <%= simple_form_for(@user, url: save_career_interests_users_path(@user), method: :get, local: true, html: { class: 'form-horizontal' }, wrapper: :horizontal_form) do |f| %>
    <%= f.error_notification %>
    <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
    <%= f.hidden_field :sid, value: @user.sid %>
    <%= f.hidden_field :uuid, value: @user.uuid %>
    <% if @user.sid.nil? %>
      <div class="form-group">
        <%= f.input :email, disabled: true, label: "Email (Disabled)", input_html: {style: 'width: 600px; background-color: #D8A7B1'} %>
        <%= f.input :sid, disabled: false, label: "StudentID ", input_html: {style: 'width: 600px; background-color :#B4F8C8'} %>
      </div>
    <% else %>
    <div class="form-group">
      <%= f.input :sid, disabled: true, label: "StudentID (Disabled)", input_html: {style: 'width: 600px; background-color: #D8A7B1'} %>
    </div>
    <% end %>

    <div class="form-inputs">
      <div class="form-group">
        <%= f.input :full_name, input_html: {style: 'width: 600px; background-color: #B4F8C8'} %>
      </div>
      <br>
      <div class="form-group">

        <div class="card ms-5" style="width: 600px">
          <div class="card-body">
            <div class="form-check">
               <% i = 0 %>
               <% Student.specialties.each do |specialty| %>
                 <% i += 1 %>
                 <div class="form-check">
                   <% if @career_interest.include? specialty %>
                    <input class="form-check-input MyCheckBoxSpecialties" type="checkbox" id="checkboxId_<%= i %>" value="<%= specialty %>" name="specialties[]" checked>
                   <% else %>
                    <input class="form-check-input MyCheckBoxSpecialties" type="checkbox" id="checkboxId_<%= i %>" value="<%= specialty %>" name="specialties[]" >
                   <% end %>
                   <label class="form-check-label" for="checkboxId_<%= i %>">
                     <%= specialty %>
                   </label>
                 </div>
                <% end %>
                <input id="other_specialty" name="other_specialty" type="text" value="<%= @other_interest %>" placeholder="other" class="form-control" >
            </div>
          </div>
        </div>


      </div>
    </div>
    <br>
    <div class="form-actions">
      <%= f.button :submit, "Save Specialties Interest", class: 'btn btn-success' %>
      <%= link_to "Cancel", :back, class: 'btn btn-warning' %>
    </div>
  <% end %>
</div>
